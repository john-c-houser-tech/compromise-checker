{% import "icons.html.j2" as draw %}
<!doctype html>
<html lang="en"{% if request is defined and theme(request) %} data-theme="{{ theme(request) }}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{% block title %}{{ product_name() }}{% endblock %}</title>
<link rel="icon" href="{{ url('favicon_svg') }}" type="image/svg+xml">
<link rel="icon" href="{{ url('favicon_ico') }}" sizes="32x32">
<link rel="stylesheet" href="{{ url('style') }}">
{% block head %}{% endblock %}
</head>
{% if false %}{% block body_class %}{% endblock %}{% endif %}
{% set body_class = self.body_class() | trim %}
<body{% if body_class %} class="{{ body_class }}"{% endif %}>
{% set signed_in = request is defined and fully_signed_in(request) %}
{% set here = section(request) if request is defined else "" %}
<header class="bar">
  <div class="bar-in">
    <a class="brand" href="{{ url('fleet') }}">{{ draw.coil() }}<span class="brand-words"><strong>{{ product_name() }}</strong><span>NouriLoop</span></span></a>
    {% if signed_in %}
    <nav class="bar-nav" aria-label="Main">
      {% for part, view, words in [("servers", "fleet", "Servers"), ("checks", "checks", "Checks"), ("threats", "threats", "Known threats"), ("manage", "manage", "Manage"), ("activity", "activity", "Activity")] %}
      {% if part != "manage" or full_access(request) %}
      <a href="{{ url(view) }}"{% if here == part %} aria-current="{{ 'page' if request.resolver_match.url_name == view else 'true' }}"{% endif %}>{{ draw.icon(part) }}{{ words }}</a>
      {% endif %}
      {% endfor %}
      <a class="phone-only" href="{{ url('two_factor_manage') }}"{% if here == "security" %} aria-current="{{ 'page' if request.resolver_match.url_name == 'two_factor_manage' else 'true' }}"{% endif %}>{{ draw.icon("security") }}Sign-in security</a>
    </nav>
    {% endif %}
    <div class="bar-end">
      {% if request is defined and request.user is defined and request.user.is_authenticated %}
      {% if signed_in %}<a class="avatar" href="{{ url('two_factor_manage') }}" title="{{ request.user.get_username() }}: sign-in security"{% if here == "security" %} aria-current="{{ 'page' if request.resolver_match.url_name == 'two_factor_manage' else 'true' }}"{% endif %}><span class="visually-hidden">Sign-in security for {{ request.user.get_username() }}</span><span aria-hidden="true">{{ initial(request) }}</span></a>
      {% else %}<span class="avatar" title="Signed in as {{ request.user.get_username() }}"><span class="visually-hidden">Signed in as {{ request.user.get_username() }}</span><span aria-hidden="true">{{ initial(request) }}</span></span>{% endif %}
      {% endif %}
      {# Not on a page a form sent back, such as new recovery codes: leaving it loses them. #}
      {% if request is defined and request.method == "GET" %}
      <form class="theme-switch" method="post" action="{{ url('theme') }}">{{ csrf_input }}<input type="hidden" name="back" value="{{ page_back(request) }}"><button class="to-dark" name="theme" value="dark" title="Dark mode" aria-label="Switch to dark mode">{{ draw.icon("moon") }}</button><button class="to-light" name="theme" value="light" title="Light mode" aria-label="Switch to light mode">{{ draw.icon("sun") }}</button></form>
      {% endif %}
      {% if request is defined and request.user is defined and request.user.is_authenticated %}
      <form method="post" action="{{ url('logout') }}">{{ csrf_input }}<button class="bar-button">Sign out</button></form>
      {% endif %}
    </div>
  </div>
</header>
<main>
{% block band %}{% endblock %}
<div class="main-in">
{% block nudge %}{% set nudge = two_factor_nudge(request) if request is defined else none %}{% if nudge == "off" %}
<p class="nudge">Your results describe weaknesses an attacker could use, and a password alone can be stolen. <a href="{{ url('two_factor_setup') }}">Turn on two-factor sign-in</a>: it takes about two minutes and an authenticator app on your phone.</p>
{% elif nudge == "unsaved" %}
<p class="nudge">Your recovery codes may not have been saved, and without them a lost phone locks you out. <a href="{{ url('two_factor_manage') }}">Make new ones in Sign-in security</a>.</p>
{% endif %}
{% set newer = update_notice(request) if request is defined else none %}{% if newer %}
<p class="nudge{% if newer.security_fix %} error{% endif %}">{% if newer.security_fix %}<strong>Version {{ newer.version }} of this tool fixes a security problem.</strong> Install it soon:{% else %}Version {{ newer.version }} of this tool is available, published {{ newer.published }}.{% endif %} <a href="{{ url('manage_updates') }}">Updates</a>.</p>
{% endif %}
{% for notice in (machine_notices(request) if request is defined else []) %}
{% if notice == "ssh_passwords" %}
<p class="nudge">This machine still lets people log in over SSH with a password, which can be guessed. Once an administrator can log in with a key, turn passwords off: the install guide says how.</p>
{% elif notice == "restart_needed" %}
<p class="nudge">An update to this machine is waiting for a restart before it takes effect. Restart it when no check is running. It never restarts by itself.</p>
{% elif notice == "stale" %}
<p class="nudge">What this page knows about the machine itself hasn't been brought up to date for over three hours, so notices about its SSH and restarts may be wrong. The compromise-checker-status timer may have stopped.</p>
{% endif %}
{% endfor %}{% endblock %}
{% block main %}{% endblock %}
</div>
</main>
</body>
</html>
