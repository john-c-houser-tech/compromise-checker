<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{% block title %}{{ product_name() }}{% endblock %}</title>
<link rel="stylesheet" href="{{ url('style') }}">
{% block head %}{% endblock %}
</head>
<body>
<header>
  <strong>{{ product_name() }}</strong>
  <span>Find out if your server has been hacked</span>
  {% if request is defined and fully_signed_in(request) %}
  <nav aria-label="Main">
    <a href="{{ url('fleet') }}">Servers</a>
    <a href="{{ url('checks') }}">Checks</a>
    <a href="{{ url('threats') }}">Known threats</a>
    <a href="{{ url('manage') }}">Manage</a>
    <a href="{{ url('activity') }}">Activity</a>
    <a href="{{ url('two_factor_manage') }}">Sign-in security</a>
  </nav>
  {% endif %}
  {% if request.user is defined and request.user.is_authenticated %}
  <form method="post" action="{{ url('logout') }}">{{ csrf_input }}<button>Sign out</button></form>
  {% endif %}
</header>
<main>
{% block nudge %}{% set nudge = two_factor_nudge(request) if request is defined else none %}{% if nudge == "off" %}
<p class="nudge">Your results describe weaknesses an attacker could use, and a password alone can be stolen. <a href="{{ url('two_factor_setup') }}">Turn on two-factor sign-in</a>: it takes about two minutes and an authenticator app on your phone.</p>
{% elif nudge == "unsaved" %}
<p class="nudge">Your recovery codes may not have been saved, and without them a lost phone locks you out. <a href="{{ url('two_factor_manage') }}">Make new ones in Sign-in security</a>.</p>
{% endif %}{% endblock %}
{% block main %}{% endblock %}
</main>
</body>
</html>
