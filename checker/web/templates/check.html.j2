{% extends "base.html.j2" %}
{% block title %}{{ run.kind }}: {{ product_name() }}{% endblock %}
{% block head %}{% if run.running %}<meta http-equiv="refresh" content="3">{% endif %}{% endblock %}
{% block main %}
<p class="back"><a href="{{ url('checks') }}">All checks</a></p>
<h1 class="page-title">{{ run.kind }} of {{ run.hosts }}</h1>
{% if busy %}<p class="error" role="alert">Another check was already running, so yours didn't start. This is that one: when it's done, <a href="{{ url('check_new') }}">start yours again</a>.</p>{% endif %}
{% if run.running %}
<p role="status">Running. This page updates by itself, and you can leave it: it carries on.</p>
<form method="post" action="{{ url('check_stop', run_id=run.id) }}">{{ csrf_input }}<button>Stop this check</button></form>
{% else %}
<p role="status">{{ run.state[:1] | upper }}{{ run.state[1:] }}.{% if run.state in ("finished", "finished with problems") %} <a href="{{ url('fleet') }}">See your servers</a>.{% endif %}</p>
{% if from_decide %}<p><a href="{{ url('decide') }}?host={{ run.hosts | urlencode }}">See what it proposed</a></p>{% endif %}
{% endif %}
{% if try_these %}
<h2>What to look at</h2>
<ul>{% for words in try_these %}<li>{{ words | visible(2000) }}</li>{% endfor %}</ul>
<ul>{% for name in check_hosts %}<li><a href="{{ url('manage_prepare') }}?host={{ name | urlencode }}">What to set up on {{ name }}</a></li>{% endfor %}</ul>
{% endif %}
{% if lines %}
<h2>What it reported</h2>
<div class="from-server">
{% for line in lines %}<p>{{ line }}</p>{% endfor %}
</div>
{% endif %}
{% endblock %}
