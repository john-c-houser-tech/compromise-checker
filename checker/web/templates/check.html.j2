{% extends "base.html.j2" %}
{% block title %}{{ run.kind }}: {{ product_name() }}{% endblock %}
{% block head %}{% if run.running %}<meta http-equiv="refresh" content="3">{% endif %}{% endblock %}
{% block main %}
<p class="back"><a href="{{ url('checks') }}">All checks</a></p>
<h1 class="page-title">{{ run.kind }} of {{ run.hosts }}</h1>
{% if run.running %}
<p role="status">Running. This page updates by itself, and you can leave it: the check carries on.</p>
<form method="post" action="{{ url('check_stop', run_id=run.id) }}">{{ csrf_input }}<button>Stop this check</button></form>
{% else %}
<p role="status">{{ run.state[:1] | upper }}{{ run.state[1:] }}.{% if run.state in ("finished", "finished with problems") %} <a href="{{ url('fleet') }}">See your servers</a>.{% endif %}</p>
{% endif %}
{% if lines %}
<h2>What it reported</h2>
<div class="from-server">
{% for line in lines %}<p>{{ line }}</p>{% endfor %}
</div>
{% endif %}
{% endblock %}
