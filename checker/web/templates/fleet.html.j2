{% extends "base.html.j2" %}
{% from "parts.html.j2" import scale, notes %}
{% block title %}Your servers: {{ product_name() }}{% endblock %}
{% block main %}
<div class="answer tone-{{ headline_tone }}">
  <h1>{{ headline }}</h1>
  <p>This is an estimate from what each server's logs and settings show, not proof either way. A
  server with no warnings can still have been broken into.</p>
</div>
{% if threat_problem %}
<p class="error" role="alert">A threat update couldn't be used, so a new threat may not be covered. Ask whoever runs this tool to look at its log.</p>
{% endif %}
{% if total %}<p><a href="{{ url('check_new') }}">Check your servers now</a></p>{% endif %}
{% if not total %}
<p><a href="{{ url('manage_add') }}">Add your first server</a> to check it.</p>
{% else %}
{% if groups or tones | length > 1 or group or tone %}
<nav class="filters" aria-label="Filter servers">
  <a href="{{ url('fleet') }}"{% if not group and not tone %} aria-current="true"{% endif %}>All {{ total }}</a>
  {% for value, name in tones %}
  <a href="?show={{ value }}" class="tone-{{ value }}"{% if tone == value %} aria-current="true"{% endif %}>{{ name }}</a>
  {% endfor %}
  {% for value in groups %}
  <a href="?group={{ value | urlencode }}"{% if group == value %} aria-current="true"{% endif %}>Group: {{ value }}</a>
  {% endfor %}
</nav>
{% endif %}
{% if not rows %}<p>No servers match this filter.</p>{% endif %}
<ol class="fleet" role="list">
{% for row in rows %}
  <li class="server tone-{{ row.tone }}">
    <div class="who">
      {% set link = host_url(row.host.host) %}
      <h2>{% if link %}<a href="{{ link }}">{{ row.host.host }}</a>{% else %}{{ row.host.host }}{% endif %}</h2>
      {% if row.host.group %}<p>{{ row.host.group }}</p>{% endif %}
      {% if row.checked %}<p>{{ row.checked }}</p>{% endif %}
    </div>
    <div class="what">
      <p class="verdict">{{ row.verdict }}</p>
      {% if row.action %}<p class="action">{{ row.action }}</p>{% endif %}
      {% if row.changes %}
      <p class="new">New since the last check:</p>
      <ul>{% for change in row.changes %}<li>{{ change }}</li>{% endfor %}</ul>
      {% endif %}
      {{ notes(row) }}
    </div>
    <div class="chance">
      {% if row.host.probability is not none and row.host.state == "analysed" %}
      <p><strong>{{ row.host.probability | percent }}</strong> estimated chance of a break-in</p>
      {{ scale(row.host.probability) }}
      {% else %}
      <p class="none">No estimate</p>
      {% endif %}
    </div>
  </li>
{% endfor %}
</ol>
{% endif %}
{% endblock %}
