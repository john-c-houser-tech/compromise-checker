{% extends "base.html.j2" %}
{% from "parts.html.j2" import scale, notes %}
{% import "icons.html.j2" as draw %}
{% block title %}{{ row.host.host }}: {{ product_name() }}{% endblock %}
{% block band %}
<section class="band" aria-labelledby="server-name">
  <div class="band-in host-band tone-{{ row.tone }}">
    <p class="back"><a href="{{ url('fleet') }}">{{ draw.icon("back") }}All servers</a></p>
    <div class="host-title">
      <span class="badge">{{ draw.icon(row.tone if row.tone in ("critical", "high", "elevated", "low") else "unknown") }}</span>
      <div>
        <h1 id="server-name">{{ row.host.host }}</h1>
        <p class="verdict">{{ row.verdict }}</p>
        {% if row.action %}<p class="action">{{ row.action }}</p>{% endif %}
        {% set meta = [row.host.group, row.checked] | select | list %}
        {% if meta %}<p class="meta">{{ meta | join(" · ") }}</p>{% endif %}
      </div>
    </div>
    <div class="chance host-chance">
      {% if row.host.probability is not none and row.host.state == "analysed" %}
      <p><strong>{{ row.host.probability | percent }}</strong> estimated chance of a break-in</p>
      {{ scale(row.host.probability) }}
      <p class="scale-words" aria-hidden="true"><span>Unlikely</span><span>Possible</span><span>Likely</span><span>Very likely</span></p>
      {% else %}
      <p class="none">No estimate</p>
      {% endif %}
    </div>
    {{ notes(row) }}
    {% if full_access(request) and (can_check or sections or suppressed) %}
    <div class="actions">
      {% if can_check %}<a class="button" href="{{ url('check_new') }}?host={{ row.host.host | urlencode }}">{{ draw.icon("checks") }}Check this server now</a>{% endif %}
      {% if sections or suppressed %}<a class="button quiet" href="{{ url('evidence', name=row.host.host) }}">{{ draw.icon("evidence") }}See the evidence</a>{% endif %}
      {% if can_check %}<a class="button quiet" href="{{ url('decide') }}?host={{ row.host.host | urlencode }}">Decide what's normal here</a>
      <form method="post" action="{{ url('analyze_start') }}">
        {{ csrf_input }}
        <input type="hidden" name="host" value="{{ row.host.host }}">
        <button class="quiet">Work it out again from what was last collected</button>
      </form>{% endif %}
    </div>
    {% endif %}
  </div>
</section>
{% endblock %}
{% block main %}
<div class="host-layout">
<div class="host-side">
  {% if sections or suppressed or gaps or row.exposures %}
  <section class="side-card">
    <h2>At a glance</h2>
    <dl class="glance">
      {# The cards each section shows, as its heading counts them; what's only for information on its own line. #}
      {% for section in sections if section.findings %}<dt>{{ section.title }}</dt><dd>{{ section.findings | length }}</dd>{% endfor %}
      {% set information = sections | map(attribute="minor") | map("length") | sum %}
      {% if information %}<dt>For information</dt><dd>{{ information }}</dd>{% endif %}
      {% if suppressed %}<dt>Hidden as accepted</dt><dd>{{ suppressed | length }}</dd>{% endif %}
      {% if gaps %}<dt>Couldn't be checked</dt><dd>{{ gaps | length }}</dd>{% endif %}
      {% if row.exposures %}<dt>Known threats</dt><dd>{{ row.exposures | length }}</dd>{% endif %}
    </dl>
  </section>
  {% endif %}
  <section class="side-card side-note">
    {{ draw.buoy() }}
    <div>
      <p>This is an estimate, not proof either way. A finding is a reason to look, and many have innocent explanations. Before changing anything on a server you think was broken into, get advice: what's on it may be evidence.</p>
      <p>Text in a box like <span class="from-server">this</span> comes from the server, and an intruder could have written it. This tool's advice only appears under "What to do", and the AI advisor's words, if any, have their own labelled section.</p>
    </div>
  </section>
</div>
<div class="host-main">
{% if (sections or suppressed) and not full_access(request) %}<p><a href="{{ url('evidence', name=row.host.host) }}">See the evidence behind these findings</a></p>{% endif %}
{% for section in sections %}
<section class="findings">
  <h2>{{ section.title }} <span>({{ section.findings | length }})</span></h2>
  {% for f in section.findings %}
  <article class="finding band-{{ f.band_class }}">
    <p class="severity" aria-hidden="true">{% if f.band_class in ("critical", "high", "medium") %}{{ draw.icon({"critical": "critical", "high": "high", "medium": "elevated"}[f.band_class]) }}{% endif %}<span>{{ f.band_words }}</span>{% if f.new %}<span class="fresh">New since the last check</span>{% endif %}{% if f.number %} <span class="number">F-{{ f.number }}</span>{% endif %}</p>
    <div class="finding-body">
      <h3><span class="visually-hidden">{{ f.band_words }}{% if f.new %}, new since the last check{% endif %}{% if f.number %}, F-{{ f.number }}{% endif %}: </span>{{ f.meaning }}</h3>
      {% if f.raised_by %}<p class="raised">A known threat makes this more serious: {{ f.raised_by }}.</p>{% endif %}
      <p>{{ f.title }}</p>
      <p class="from-server">{{ f.summary | visible(400) }}</p>
      {% if f.uncertain %}<p>The check only saw part of this, so it may be wrong. Details:</p><p class="from-server">{{ f.uncertain }}</p>{% endif %}
      <p class="todo">{{ draw.icon("todo") }}<span><strong>What to do:</strong> {{ f.todo }}</span></p>
    </div>
  </article>
  {% endfor %}
  {% if section.minor %}
  <details class="minor">
    <summary>{{ section.minor | length }} for information</summary>
    <ul>{% for f in section.minor %}<li>{{ f.title }} <span class="from-server">{{ f.summary }}</span>{% if f.lowered %} Lowered by your maintenance window.{% endif %}</li>{% endfor %}</ul>
  </details>
  {% endif %}
</section>
{% endfor %}
{% if caveat %}
<p>{{ caveat }}</p>
{% endif %}
{% if row.exposures %}<p><a href="{{ url('threats') }}">What to do about these known threats</a></p>{% endif %}
{% if advice_unreadable %}<p class="error">What the AI advisor said can't be read.</p>{% endif %}
{% if explain or remediation or nothing_came %}
<section class="findings ai">
  <h2>What the AI advisor said</h2>
  <p class="note">This is advice from an AI model, not a finding. It doesn't change the estimate above. It read what the server's logs say, and an intruder can write things into logs to mislead it, so weigh it against what you know.</p>
  {% for x in nothing_came %}<p class="error">A newer request for the {{ x.name }} came to nothing ({{ x.at | when }}): {{ x.note | visible(400) }}.</p>{% endfor %}
  {% if explain %}
  <div class="from-ai">
    {% if explain.meta.stale %}<p class="error">This is about an older check, not the one shown here.</p>{% endif %}
    {% if explain.meta.warning %}<p class="error">{{ explain.meta.warning | visible(600) }}</p>{% endif %}
    <p><strong>{{ explain.verdict | visible(80) }}.</strong> {{ explain.summary | visible(2000) }}</p>
    {% if explain.important %}<h3>Most important</h3><ul>{% for p in explain.important %}<li>{{ p.finding | visible(20) }}: {{ p.why | visible(1000) }}</li>{% endfor %}</ul>{% endif %}
    {% if explain.innocent %}<h3>Possible innocent explanations</h3><ul>{% for p in explain.innocent %}<li>{{ p.finding | visible(20) }}: {{ p.explanation | visible(1000) }}</li>{% endfor %}</ul>{% endif %}
    {% if explain.settle %}<h3>What would settle it</h3><ul>{% for q in explain.settle %}<li>{{ q | visible(1000) }}</li>{% endfor %}</ul>{% endif %}
    <p class="note">{{ explain.meta.model }}, {{ explain.meta.at | when }}.{% if explain.meta.declined_by %} Declined first by {{ explain.meta.declined_by | join(", ") }}.{% endif %}{% if explain.meta.redaction %} Redaction: {{ explain.meta.redaction }}.{% endif %}{% if explain.meta.local %} A local model: read it with more care.{% endif %} "F-" numbers are the findings above.</p>
  </div>
  {% endif %}
  {% if remediation %}
  <div class="from-ai">
    <h3>Suggested steps: {{ remediation.urgency }}</h3>
    {% if remediation.meta.stale %}<p class="error">This is about an older check, not the one shown here.</p>{% endif %}
    {% if remediation.meta.warning %}<p class="error">{{ remediation.meta.warning | visible(600) }}</p>{% endif %}
    <p>{{ remediation.summary | visible(2000) }}</p>
    <p class="note">Nothing here has been run. Have someone who knows this server read each command before using it.</p>
    {% for stage in remediation.stages %}
    <h4>{{ stage.title }}</h4>
    <ol>{% for s in stage.steps %}<li><code>{{ s.action | visible(1000) }}</code>{% if s.destructive %} <strong>This destroys evidence.</strong>{% endif %}<br>Why: {{ s.why | visible(600) }}<br>Risk: {{ s.risk | visible(400) }}</li>{% endfor %}</ol>
    {% endfor %}
    {% if remediation.tell %}<h4>Who to tell</h4><ul>{% for x in remediation.tell %}<li>{{ x.role | visible(120) }}: {{ x.what | visible(400) }} ({{ x.when | visible(120) }})</li>{% endfor %}</ul>{% endif %}
    <p class="note">{{ remediation.meta.model }}, {{ remediation.meta.at | when }}.{% if remediation.meta.declined_by %} Declined first by {{ remediation.meta.declined_by | join(", ") }}.{% endif %}{% if remediation.meta.redaction %} Redaction: {{ remediation.meta.redaction }}.{% endif %}{% if remediation.meta.local %} A local model: read it with more care.{% endif %}</p>
  </div>
  {% endif %}
</section>
{% elif advisor_off %}
<p class="note">The AI advisor is off. It can explain these findings in more detail if your organization turns it on.</p>
{% endif %}
{% if suppressed %}
<section class="findings">
  <h2>Hidden by your list of accepted activity <span>({{ suppressed | length }})</span></h2>
  <p class="note">You or someone with access decided these are expected. If that's not right, they shouldn't be hidden.</p>
  <ul>{% for f in suppressed %}<li>{{ f.band_words }}: {{ f.title }} <span class="from-server">{{ f.summary }}</span></li>{% endfor %}</ul>
</section>
{% endif %}
{% if gaps or reach is not none %}
<section class="findings">
  <h2>What the check couldn't see</h2>
  {% if reach is not none %}<p class="note">{{ reach }}</p>{% endif %}
  {% if gaps %}<ul>{% for gap in gaps %}<li>{{ gap }}</li>{% endfor %}</ul>{% endif %}
</section>
{% endif %}
</div>
</div>
{% endblock %}