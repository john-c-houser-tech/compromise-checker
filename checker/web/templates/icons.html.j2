<svg class="{{ class }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M17 43l3-27h8l3 27z"/><path d="M15 16h18"/><path d="M19 16v-6h10v6"/><path d="M21 10l3-4 3 4"/><path class="beam" d="M33 9l8-3M33 13h9M15 9L7 6M15 13H6"/><path d="M10 43h28"/><path d="M18.9 26h10.2M18 35h12"/></svg>
{% endmacro %}
