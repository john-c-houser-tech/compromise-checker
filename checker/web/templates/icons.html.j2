{# The pages' drawings: NouriLoop's own marks, and simple line icons drawn for this tool. All inline,
   so a page loads nothing it doesn't ship, and each takes its colour from the text around it. #}
{% macro coil(class="mark") %}
<svg class="{{ class }}" viewBox="-2 -2 68 68" aria-hidden="true" focusable="false"><rect class="mark-tile" x="-2" y="-2" width="68" height="68" rx="13"/><path class="mark-rope" d="M28 30a4 4 0 0 1 8 0a8 8 0 0 1-16 0a12 12 0 0 1 24 0a16 16 0 0 1-32 0a20 20 0 0 1 40 0a24 24 0 0 1-24 24h22" fill="none" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
{% endmacro %}
{% macro line(paths, class="icon", size=24) %}
<svg class="{{ class }}" viewBox="0 0 {{ size }} {{ size }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{% for d in paths %}<path d="{{ d }}"/>{% endfor %}</svg>
{% endmacro %}
