{% extends "base.html.j2" %}
{% import "icons.html.j2" as draw %}
{% block title %}Manage: {{ product_name() }}{% endblock %}
{% block band %}
<section class="band" aria-labelledby="page-title">
  <div class="band-in page-band">
    <h1 id="page-title" class="page-title">Manage your servers</h1>
  </div>
</section>
{% endblock %}
{% block main %}
<ul class="tiles" role="list">
  {% for view, icon, words in [("first_setup", "forward", "First setup"), ("manage_add", "add", "Add a server"), ("manage_threats", "threats", "Threat updates"), ("manage_settings", "manage", "Settings"), ("manage_schedule", "checks", "Check every day"), ("manage_purge", "evidence", "Delete stored evidence"), ("manage_people", "security", "People")] %}
  <li><a href="{{ url(view) }}"><span class="tile-icon">{{ draw.icon(icon) }}</span>{{ words }}</a></li>
  {% endfor %}
</ul>
{% if not rows %}
<p>There are no servers yet. Add one to check it.</p>
{% else %}
<div class="record-wrap">
<table class="record">
  <thead><tr><th scope="col">Server</th><th scope="col">Logs in as</th><th scope="col">Group</th><th scope="col">Identity</th></tr></thead>
  <tbody>
  {% for row in rows %}
  <tr>
    <td><a href="{{ url('manage_server') }}?host={{ row.name | urlencode }}">{{ row.name }}</a></td>
    <td>{{ row.where }}</td>
    <td>{{ row.group or "None" }}</td>
    <td>{% if row.unreadable %}<span class="error">Can't be read</span>{% elif row.trusted %}Confirmed{% else %}<span class="error">Not confirmed yet, so it can't be checked from here</span>{% endif %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}
{% if groups %}
<h2 class="section-title">Groups</h2>
<p class="note">Servers in a group share its whitelist rules and threat update settings. A group exists while a server is in it: choose it on the server's page.</p>
<ul>
  {% for group in groups %}<li><strong>{{ group.name }}</strong>: {{ group.members | join(", ") }}</li>{% endfor %}
</ul>
{% endif %}
{% endblock %}
