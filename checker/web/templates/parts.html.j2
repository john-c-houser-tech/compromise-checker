{% macro scale(probability) %}
<svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <rect class="zone-low" x="0" y="3" width="10" height="4"/>
  <rect class="zone-elevated" x="10" y="3" width="40" height="4"/>
  <rect class="zone-high" x="50" y="3" width="40" height="4"/>
  <rect class="zone-critical" x="90" y="3" width="10" height="4"/>
  <line class="mark" x1="{{ '%.1f' | format(probability * 100) }}" y1="0" x2="{{ '%.1f' | format(probability * 100) }}" y2="10"/>
</svg>
{% endmacro %}
{% macro notes(row) %}
{% if row.notes or row.exposures %}
<ul class="notes">
  {% for note in row.notes %}<li>{{ note }}</li>{% endfor %}
  {% for exposure in row.exposures %}<li>{{ exposure }}</li>{% endfor %}
</ul>
{% endif %}
{% endmacro %}
{% macro confirm() %}
<label>Your password, to confirm <input name="confirm_password" type="password" autocomplete="new-password" required></label>
{% endmacro %}
