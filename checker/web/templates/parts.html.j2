{% macro scale(probability) %}
<svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <rect class="zone-low" x="0" y="3" width="10" height="4"/>
  <rect class="zone-elevated" x="10" y="3" width="40" height="4"/>
  <rect class="zone-high" x="50" y="3" width="40" height="4"/>
  <rect class="zone-critical" x="90" y="3" width="10" height="4"/>
  <line class="mark" x1="{{ '%.1f' | format(probability * 100) }}" y1="0" x2="{{ '%.1f' | format(probability * 100) }}" y2="10"/>
</svg>
{% endmacro %}
{% macro notes(row) %}
{% if row.notes or row.exposures %}
<ul class="notes">
  {% for note in row.notes %}<li>{{ note }}</li>{% endfor %}
  {% for exposure in row.exposures %}<li>{{ exposure }}</li>{% endfor %}
</ul>
{% endif %}
{% endmacro %}
{% macro confirm(with_code=False) %}
<label>Your password, to confirm <input name="confirm_password" type="password" autocomplete="new-password" required></label>
{% if with_code %}<label>A code from your authenticator app, or a recovery code <input name="confirm_code" autocomplete="one-time-code" required></label>{% endif %}
{% endmacro %}
{% macro server_fields(values, groups) %}
<label>Address <small>Its host name or IP address.</small> <input name="address" value="{{ values.address }}" required></label>
<label>SSH port <input name="port" value="{{ values.port }}" inputmode="numeric" required></label>
<label>Account <small>The account that logs in, usually one made just for this.</small> <input name="user" value="{{ values.user }}" required></label>
<label>How it logs in
  <select name="auth">
    <option value="key"{% if values.auth == "key" %} selected{% endif %}>A key file on this machine</option>
    <option value="agent"{% if values.auth == "agent" %} selected{% endif %}>An SSH agent</option>
    <option value="password"{% if values.auth == "password" %} selected{% endif %}>A password</option>
  </select>
</label>
<label>Key file <small>The full path on this machine, if it logs in with a key file.</small> <input name="key_path" value="{{ values.key_path }}"></label>
<label>How it gets administrator rights
  <select name="sudo">
    <option value="nopasswd"{% if values.sudo == "nopasswd" %} selected{% endif %}>sudo, with no password</option>
    <option value="password"{% if values.sudo == "password" %} selected{% endif %}>sudo, with a password</option>
    <option value="root"{% if values.sudo == "root" %} selected{% endif %}>It logs in as root</option>
  </select>
</label>
<label>Where the password comes from <small>Only if it uses one. A scheduled check can't type a password, so it needs the keyring.</small>
  <select name="password_source">
    <option value="prompt"{% if values.password_source == "prompt" %} selected{% endif %}>Typed when a check starts</option>
    <option value="keyring"{% if values.password_source == "keyring" %} selected{% endif %}>This machine's keyring</option>
  </select>
</label>
<label>Group <small>Optional. Type a new name, or one you already use.</small> <input name="group" value="{{ values.group }}" list="known-groups"></label>
<datalist id="known-groups">{% for group in groups %}<option value="{{ group }}"></option>{% endfor %}</datalist>
<details>
  <summary>Rarely needed</summary>
  <label>Website folders <small>One per line, if its websites aren't in the usual places.</small> <textarea name="web_roots" rows="3">{{ values.web_roots }}</textarea></label>
  <label>Python on the server <input name="python" value="{{ values.python }}"></label>
  <label>Starting estimate, in percent <small>How likely it is to be hacked before any evidence. Leave it empty for the usual figure. A lower one makes the same findings look less worrying.</small> <input name="prior" value="{{ values.prior }}" inputmode="decimal"></label>
</details>
{% endmacro %}
{% macro setting_field(field) %}
  {% if not field.editable %}
  <p><strong>{{ field.label }}:</strong> set on the command line, so it can't be changed here.</p>
  {% elif field.kind == "choice" %}
  <label>{{ field.label }}{% if field.help %} <small>{{ field.help }}</small>{% endif %}
    <select name="{{ field.key }}">
      {% for value, words in field.options %}<option value="{{ value }}"{% if field.value == value %} selected{% endif %}>{{ words }}</option>{% endfor %}
    </select>
  </label>
  {% elif field.kind == "onoff" %}
  <label>{{ field.label }}{% if field.help %} <small>{{ field.help }}</small>{% endif %}
    <select name="{{ field.key }}">
      <option value="on"{% if field.value == "on" %} selected{% endif %}>On</option>
      <option value="off"{% if field.value == "off" %} selected{% endif %}>Off</option>
    </select>
  </label>
  {% else %}
  <label>{{ field.label }}{% if field.help %} <small>{{ field.help }}</small>{% endif %} <input name="{{ field.key }}" value="{{ field.value }}"></label>
  {% endif %}
{% endmacro %}
