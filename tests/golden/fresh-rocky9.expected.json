    "id": "base-php-fpm-opcache",
    "layer": "profile base",
    "match": {
     "check": "process.injected",
     "exe": "/usr/sbin/php-fpm*",
     "variant": "shared"
    },
    "owner": "Compromise Checker defaults",
    "reason": "PHP's opcache keeps its JIT code in shared memory, which /proc's maps show as \"/dev/zero (deleted)\". Only the shared-memory kind, only PHP-FPM as installed by the system: a memory-only file, a deleted file or a scratch file mapped into PHP-FPM still shows. Code a script maps the same way (PHP's FFI) looks the same and is let through too."
   },
   {
    "broad": false,
    "expires": "never",
    "file": "checker/profiles/base.yaml",
    "id": "base-firewalld-libffi",
    "layer": "profile base",
    "match": {
     "check": "process.injected",
     "exe": "/usr/bin/python3*",
     "program": "firewalld",
     "variant": "libffi"
    },
    "owner": "Compromise Checker defaults",
    "reason": "firewalld (RHEL, Rocky, Alma) runs on Python, whose ctypes has libffi make its closures in memory-only files. Only the libffi kind, only firewalld on the system's Python: another Python process with such a file stays a (low) finding, and code from a deleted or scratch file always does."
   }
